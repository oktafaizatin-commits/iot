#include <Wire.h>
#include <LiquidCrystal_I2C.h>

LiquidCrystal_I2C lcd(0x27, 16, 2);

int jam = 12;
int menit = 0;
int detik = 0;

void setup() {
  lcd.init();
  lcd.backlight();

  lcd.setCursor(3, 0);
  lcd.print("JAM DIGITAL");
}

void loop() {
  lcd.setCursor(4, 1);

  if (jam < 10) lcd.print("0");
  lcd.print(jam);
  lcd.print(":");

  if (menit < 10) lcd.print("0");
  lcd.print(menit);
  lcd.print(":");

  if (detik < 10) lcd.print("0");
  lcd.print(detik);

  delay(1000);

  detik++;

  if (detik == 60) {
    detik = 0;
    menit++;
  }

  if (menit == 60) {
    menit = 0;
    jam++;
  }

  if (jam == 24) {
    jam = 0;
  }
}
