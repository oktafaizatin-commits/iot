#include <ESP32Servo.h>

// Membuat 12 objek servo
Servo servo[12];

// Pin ESP32
int pinServo[12] = {
  13, 14, 18, 19, 21, 22,
  23, 25, 26, 27, 32, 33
};

void gerakSemua(int sudut) {
  for (int i = 0; i < 12; i++) {
    servo[i].write(sudut);
  }
}

void setup() {
  for (int i = 0; i < 12; i++) {
    servo[i].setPeriodHertz(50);
    servo[i].attach(pinServo[i], 500, 2400);
    servo[i].write(90);
  }

  delay(1000);
}

void loop() {

  // Gerakan 1: Semua menghadap kiri
  gerakSemua(30);
  delay(500);

  // Gerakan 2: Semua menghadap kanan
  gerakSemua(150);
  delay(500);

  // Gerakan 3: Kembali ke tengah
  gerakSemua(90);
  delay(500);

  // Gerakan 4: Bergantian kiri dan kanan
  for (int i = 0; i < 12; i++) {
    servo[i].write(30);
  }
  delay(500);

  for (int i = 0; i < 12; i++) {
    servo[i].write(150);
  }
  delay(500);

  // Gerakan 5: Tarian bergelombang
  for (int i = 0; i < 12; i++) {
    servo[i].write(30);
    delay(150);
    servo[i].write(150);
  }
  delay(500);

  // Gerakan 6: Semua kembali ke posisi awal
  gerakSemua(90);
  delay(1000);
}
